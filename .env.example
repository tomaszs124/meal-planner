# Copy to .env.local (local dev) and set the same values in Vercel → Project Settings → Environment Variables.
# Never commit real secrets. Details: docs/mcp/setup.md

# --- Public (exposed to the browser) ---------------------------------------
# Supabase project URL (Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable / anon key (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: public base URL of the app, used for links returned by the MCP search/fetch tools
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only secrets (MCP connector, token mode) --------------------------
# With OAuth (Supabase Auth OAuth 2.1 server, see docs/mcp/setup.md section 12) none of the
# MCP_* variables are needed and SUPABASE_SERVICE_ROLE_KEY is only used by scripts/analyze-recipes.mjs.
# Supabase service role key (bypasses RLS) - server only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# One access token per household member, so everyone connects their own ChatGPT/Claude
# and the connector acts as them. Format: <token>=<email or user uuid>, separated by ";".
# Generate each token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Each member's connector URL is then https://<host>/api/mcp/<their token>
MCP_ACCESS_TOKENS=
# Legacy single-user setup (still supported): one token + the user it acts as
MCP_ACCESS_TOKEN=
MCP_ACTING_USER_EMAIL=
MCP_ACTING_USER_ID=
